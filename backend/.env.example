# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB - transactions REQUIRE a replica set (see README / `npm run db:replset`)
MONGODB_URI=mongodb://127.0.0.1:27018/stockflow?replicaSet=rs0
REQUIRE_REPLICA_SET=true

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
